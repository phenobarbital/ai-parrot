    {
      "id": 2,
      "title": "Reading this dashboard",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "Counters show estimated increases over the selected range; rate and latency panels require multiple exports. **No data** means telemetry or sufficient samples are unavailable, not zero activity. HTTP and WebSocket requests are shown separately and can include retries.\n\nQueries expect `codex_*_total` counters and classic `codex_*_duration_ms_bucket` histograms (also accepting `_duration_ms_milliseconds_bucket`). Latency values are milliseconds. Model and Authentication filters apply to every metric panel. Token usage, cost, sessions, and code changes are not inferred from request counts."
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "claudestats-prometheus"
      },
      "description": "Estimated API request increase over the selected range, including retry attempts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.0.1+security-01",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "claudestats-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(codex_api_request_total{model=~\"${model:regex}\", auth_mode=~\"${auth_mode:regex}\"}[$__range]))",
          "legendFormat": "Requests",

# Secrets template for the AI-Parrot Matrix dev stack (FEAT-463).
#
# Copy to docker/matrix/.env and fill in real values (or let
# scripts/matrix/bootstrap.sh generate random secrets for you).
# docker/matrix/.env is git-ignored — never commit real secrets.

# Shared Postgres password (Synapse + all bridge databases).
POSTGRES_PASSWORD=change-me

# Synapse secrets — generate with e.g. `openssl rand -hex 32`.
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me
SYNAPSE_MACAROON_SECRET_KEY=change-me
SYNAPSE_FORM_SECRET=change-me

# Pinned image versions (override the docker-compose.matrix.yml defaults).
SYNAPSE_VERSION=v1.157.2
ELEMENT_VERSION=v1.12.26

# Coordinator (bot) Matrix account, created by bootstrap.sh.
MATRIX_COORDINATOR_USER=parrot-bot
MATRIX_COORDINATOR_PASSWORD=change-me

# Parrot AppService registration — must match MatrixCrewConfig /
# MatrixAppServiceConfig in your crew YAML.
MATRIX_SERVER_NAME=parrot.local
MATRIX_AS_URL=http://host.docker.internal:8449

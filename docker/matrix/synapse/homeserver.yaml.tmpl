# Synapse homeserver configuration template for the AI-Parrot dev stack
# (FEAT-463). Rendered to homeserver.yaml by scripts/matrix/bootstrap.sh
# via `envsubst`. Dev-only: no TLS, no workers.
#
# Required environment variables at render time:
#   SYNAPSE_SERVER_NAME              e.g. parrot.local
#   SYNAPSE_REGISTRATION_SHARED_SECRET  random secret (see docker/matrix/.env.example)
#   SYNAPSE_MACAROON_SECRET_KEY       random secret
#   SYNAPSE_FORM_SECRET               random secret
#   POSTGRES_PASSWORD                 must match docker-compose.matrix.yml

server_name: "${SYNAPSE_SERVER_NAME}"
pid_file: /data/homeserver.pid
public_baseurl: "http://localhost:8008/"

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client, federation]
        compress: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "${POSTGRES_PASSWORD}"
    database: synapse
    host: postgres
    port: 5432
    cp_min: 5
    cp_max: 10

# Dev-only: no TLS, no federation whitelist tightening, no workers.
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"
macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"
signing_key_path: /data/signing.key

report_stats: false

# Relax default rate limits so the parrot AppService and bots aren't
# throttled during local development.
rc_message:
  per_second: 10
  burst_count: 50
rc_login:
  address:
    per_second: 10
    burst_count: 20

# The parrot AppService registration, generated by
# scripts/matrix/bootstrap.sh via `python -m parrot.integrations.matrix.registration`.
app_service_config_files:
  - /data/appservices/parrot.yaml
  # Uncommented per-bridge entries are added by bootstrap.sh when the
  # `bridges` profile is used:
  # - /data/appservices/signal-registration.yaml
  # - /data/appservices/slack-registration.yaml
  # - /data/appservices/discord-registration.yaml

log_config: /data/log.config
media_store_path: /data/media_store

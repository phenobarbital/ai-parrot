# Configuración de llama-server (docker-compose.llama.yml)
#
#   cp docker/llama/.env.example docker/llama/.env
#   docker compose --env-file docker/llama/.env -f docker-compose.llama.yml up -d
#
# El `--env-file` es OBLIGATORIO: `env_file:` en el compose solo inyecta
# variables dentro del contenedor, no alimenta la interpolación `${...}`
# que usan LLAMA_PORT / LLAMA_HF_MODEL / LLAMA_CTX / LLAMA_NGL /
# LLAMA_PARALLEL / LLAMA_EXTRA_ARGS / LLAMA_HEALTH_START. Sin él este
# fichero se ignora en silencio.
#
# Guía completa (incluida la receta MoE y el procedimiento de tuning):
#   docs/llama-server-qwen3.6.md

# Puerto en el host (el endpoint queda en http://localhost:8089/v1)
LLAMA_PORT=8089

# Modelo a servir, descargado automáticamente de Hugging Face al primer
# arranque (queda cacheado en el volumen `llama-models`).
# Formato: <repo>:<quant>
#
# Modelos pequeños de referencia (GPUs de 6-8 GB):
#   ggml-org/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M   (~2.5 GB)
#   ggml-org/gemma-3-4b-it-GGUF:Q4_K_M
LLAMA_HF_MODEL=ggml-org/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M

# ── Equipo destino: 16 GB VRAM, objetivo Qwen3.6-35B-A3B (MoE) ──────────
#
# El Q4_K_M pesa 22.3 GB, así que NO entra completo en 16 GB. Con MoE eso
# no es problema: el modelo tiene 40 capas × 256 expertos, y esos tensores
# de expertos son ~32B de los 35B totales (≈92% del modelo) pero solo se
# activan 9 de 256 por token. `--n-cpu-moe N` deja los expertos de las N
# primeras capas en RAM y mantiene en GPU atención + DeltaNet + embeddings
# + KV cache, que sí se tocan en cada token.
#
# Receta (descomentar y sustituir las dos líneas de arriba):
#   LLAMA_HF_MODEL=bartowski/Qwen_Qwen3.6-35B-A3B-GGUF:Q4_K_M
#   LLAMA_EXTRA_ARGS=--n-cpu-moe 40 --jinja --reasoning-format deepseek --alias qwen3.6-35b-a3b --threads 8 --cache-type-k q8_0 --cache-type-v q8_0
#   LLAMA_CTX=32768
#   LLAMA_PARALLEL=1
#   LLAMA_HEALTH_START=30m
#
# EMPEZAR EN 40, NO EN 12. El modelo tiene 40 capas: `--n-cpu-moe 40`
# equivale a `--cpu-moe` (todos los expertos en RAM) y es el suelo seguro.
# Cada capa que devuelves a la GPU cuesta ~0.5 GB de VRAM, así que en una
# tarjeta de 16 GB con 32K de contexto caben unas 19 capas → bajar hasta
# ~21 e ir midiendo. Procedimiento: bajar de 4 en 4, `up -d`, comprobar
# tokens/s en `.timings.predicted_per_second`, y parar 2-4 por encima del
# valor que da OOM de CUDA. Ojo: un reparto que entra a 32K revienta a
# 128K, porque el KV cache crece con --ctx-size DESPUÉS de colocar pesos.
#
# Requisitos de RAM: los expertos ocupan ~19 GB, así que hacen falta
# ≥24 GB de RAM libre. Los matmuls de expertos corren en CPU, de ahí que
# --threads (núcleos FÍSICOS, no hilos) sea una palanca de primer orden.
#
# Alternativa sin knob: una cuantización IQ4_XS (19.7 GB) o IQ3_XXS
# (~14 GB) reduce la presión, pero para un MoE el offload de expertos da
# mejor calidad por GB que bajar de cuantización.

# Para usar un GGUF local en vez de -hf: colocar el archivo en
# docker/llama/models/ y en LLAMA_EXTRA_ARGS pasar `-m /models/<archivo>.gguf`
# (dejando LLAMA_HF_MODEL vacío no funciona: comentar la línea -hf en el
# compose o sobreescribir `command`).

# Tamaño de contexto TOTAL: se reparte entre los slots de --parallel.
# Con LLAMA_CTX=8192 y LLAMA_PARALLEL=2, cada slot recibe solo 4096.
LLAMA_CTX=8192

# Capas a offloadear a GPU (99 = todas; bajar si no entra en VRAM).
# No entra en conflicto con --n-cpu-moe: -ngl sube todas las capas y luego
# --n-cpu-moe devuelve a RAM los tensores de expertos de las N primeras.
LLAMA_NGL=99

# Slots de inferencia concurrentes.
# Con expertos en CPU, los slots compiten por los mismos núcleos y los dos
# van más lentos: usar 1 para el modelo grande.
LLAMA_PARALLEL=2

# API key opcional (si se define, los clientes deben mandarla como Bearer).
# llama-server lee LLAMA_API_KEY directamente del entorno; es una de las
# pocas opciones que NO usa el prefijo LLAMA_ARG_*.
LLAMA_API_KEY=

# Margen antes de que el healthcheck marque el contenedor como unhealthy.
# /health devuelve 503 durante toda la carga. 15m cubre un MoE de 22 GB ya
# cacheado; para la PRIMERA descarga con -hf (~22 GB) subir a 30m o más.
LLAMA_HEALTH_START=15m

# Argumentos extra para llama-server (ej: --grammar-file /models/labels.gbnf)
LLAMA_EXTRA_ARGS=

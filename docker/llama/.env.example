# Configuración de llama-server (docker-compose.llama.yml)
# cp docker/llama/.env.example docker/llama/.env

# Puerto en el host (el endpoint queda en http://localhost:8089/v1)
LLAMA_PORT=8089

# Modelo a servir, descargado automáticamente de Hugging Face al primer
# arranque (queda cacheado en el volumen `llama-models`).
# Formato: <repo>:<quant>
#
# ── Equipo destino: 16 GB VRAM, objetivo Qwen3.6-35B-A3B (MoE) ──
# Un 35B-A3B en Q4_K_M pesa ~20 GB, así que NO entra completo en 16 GB.
# Con MoE eso no es problema: llama-server puede dejar los tensores de
# expertos (FFN) en RAM y mantener atención + KV cache en GPU con
# `--n-cpu-moe N`. Como solo hay ~3B parámetros activos por token, el
# rendimiento sigue siendo bueno. Receta:
#   LLAMA_HF_MODEL=<org>/Qwen3.6-35B-A3B-Instruct-GGUF:Q4_K_M
#   LLAMA_EXTRA_ARGS=--n-cpu-moe 12
# Empezar con --n-cpu-moe alto (p.ej. 16) e ir bajando mientras no haya
# OOM de CUDA; cada capa menos en CPU = más velocidad. Alternativa sin
# knob: una cuantización IQ3_XXS/Q3_K_M (~14-15 GB) entra completa pero
# queda justa con el KV cache.
#
# Modelos pequeños de referencia (GPUs de 6-8 GB):
#   ggml-org/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M   (~2.5 GB)
#   ggml-org/gemma-3-4b-it-GGUF:Q4_K_M
LLAMA_HF_MODEL=ggml-org/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M

# Para usar un GGUF local en vez de -hf: colocar el archivo en
# docker/llama/models/ y en LLAMA_EXTRA_ARGS pasar `-m /models/<archivo>.gguf`
# (dejando LLAMA_HF_MODEL vacío no funciona: comentar la línea -hf en el
# compose o sobreescribir `command`).

# Tamaño de contexto total (se reparte entre los slots de --parallel)
LLAMA_CTX=8192

# Capas a offloadear a GPU (99 = todas; bajar si no entra en VRAM)
LLAMA_NGL=99

# Slots de inferencia concurrentes
LLAMA_PARALLEL=2

# API key opcional (si se define, los clientes deben mandarla como Bearer)
LLAMA_API_KEY=

# Argumentos extra para llama-server (ej: --grammar-file /models/labels.gbnf)
LLAMA_EXTRA_ARGS=

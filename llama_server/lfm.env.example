# Run from llama_server/ with --env-file lfm.env.example.
# Select this file for container variables too; preserve the existing .env.
LLAMA_ENV_FILE=lfm.env.example
# Newer llama.cpp uses the HF cache; keep it inside the persistent volume.
HF_HOME=/root/.cache/llama.cpp/huggingface
LLAMA_BIND_HOST=127.0.0.1
LLAMA_PORT=8089
LLAMA_HF_MODEL=LiquidAI/LFM2.5-VL-1.6B-GGUF:Q4_K_M
# Alternative: LiquidAI/LFM2.5-VL-3B-GGUF:Q4_K_M
LLAMA_CTX=8192
LLAMA_NGL=99
LLAMA_PARALLEL=1
LLAMA_EXTRA_ARGS=--alias occupancy --jinja --temp 0.1 --min-p 0.15 --repeat-penalty 1.05
LLAMA_API_KEY=
LLAMA_HEALTH_START=30m

# Matrix Homeserver Configuration
# These tokens are generated by the bootstrap.sh script (FEAT-463).
# Copy this file to .env and fill in the values from the bootstrap output.

# Matrix homeserver admin token (used for Room creation, user provisioning)
# Retrieve from: docker-compose.matrix.yml logs after running bootstrap.sh
MATRIX_AS_TOKEN=your_as_token_here

# Matrix homeserver-to-appservice token (authentication from homeserver to appservice)
# Retrieve from: docker-compose.matrix.yml logs after running bootstrap.sh
MATRIX_HS_TOKEN=your_hs_token_here

# General chat room ID (where all agents answer questions)
# Retrieve from: bootstrap.sh output, or create manually via Matrix client
MATRIX_GENERAL_ROOM_ID=!your_general_room_id_here:parrot.local

# LLM Provider API Keys
# Each agent uses a different provider; copy your API keys from the respective platforms.

# OpenAI API Key (used by Web Researcher agent with gpt-4o)
# Retrieve from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (used by Financial Analyst agent with claude-sonnet-4)
# Retrieve from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google GenAI API Key (used by Report Writer agent with gemini-2.5-flash)
# Retrieve from: https://ai.google.dev/
GOOGLE_API_KEY=your-google-api-key-here

# NVIDIA API Key (used by Synthesis Agent with meta/llama-3.3-70b-instruct)
# Retrieve from: https://docs.nvidia.com/nim/llama-2/
NVIDIA_API_KEY=nvapi-your-nvidia-key-here

{
  "site": "quotes-toscrape-com",
  "name": "login",
  "title": "Iniciar sesión",
  "description": "Log in to Quotes to Scrape. The demo accepts any username/password combination.",
  "kind": "operation",
  "params": {
    "username": {
      "description": "Username for the login form",
      "required": true,
      "default": "parrot",
      "example": null
    },
    "password": {
      "description": "Password for the login form",
      "required": true,
      "default": "parrot",
      "example": null
    }
  },
  "steps": [
    {
      "action": "navigate",
      "url": "https://quotes.toscrape.com/login"
    },
    {
      "action": "fill",
      "selector": "#username",
      "value": "{{username}}"
    },
    {
      "action": "fill",
      "selector": "#password",
      "value": "{{password}}"
    },
    {
      "action": "click",
      "selector": "input[type=\"submit\"]",
      "wait_after_click": "a[href=\"/logout\"]",
      "wait_timeout": 10
    }
  ],
  "compose": [],
  "requires": [],
  "tags": [],

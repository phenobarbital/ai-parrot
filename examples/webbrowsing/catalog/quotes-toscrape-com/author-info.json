{
  "site": "quotes-toscrape-com",
  "name": "author-info",
  "title": "Ficha de autor",
  "description": "Open an author page and extract name, birth date and bio. The author parameter is the URL slug, e.g. 'Albert-Einstein'.",
  "kind": "operation",
  "params": {
    "author": {
      "description": "Author URL slug",
      "required": true,
      "default": null,
      "example": "Albert-Einstein"
    }
  },
  "steps": [
    {
      "action": "navigate",
      "url": "https://quotes.toscrape.com/author/{{author}}/"
    },
    {
      "action": "extract",
      "selector": "div.author-details",
      "extract_name": "author",
      "fields": {
        "name": {
          "selector": "h3.author-title"
        },
        "born": {
          "selector": "span.author-born-date"
        },
        "description": {
          "selector": "div.author-description"
        }
      }
    }
  ],
  "compose": [],
  "requires": [],
  "tags": [],
  "version": "1.0",
  "source": "llm",
  "created_at": "2026-08-26T10:03:30.407962Z",
  "updated_at": "2026-08-26T10:03:30.408406Z"
}
   215	def _sibling(frames: Mapping[str, "pd.DataFrame"], key: str, index: int, op_name: str) -> "pd.DataFrame":
   216	    """Return an already-executed sibling frame or raise a location-aware error."""
   217	    if key not in frames:
   218	        raise TransformError(None, index, f"{op_name}: sibling source {key!r} was not executed")
   219	    return frames[key]

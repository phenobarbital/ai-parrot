   541	                guard=getattr(self, "_dataplane_guard", None)
   542	            )
   543	            owner_pctx = build_principal_context(resolved_user_id, channel="ui_surfaces")
   544	            await service.validate_for_persistence(envelope_model, owner_pctx=owner_pctx)
   545	            envelope_dump = await service.ensure_snapshot(envelope_dump, owner_pctx=owner_pctx)
   546	
   547	        now = datetime.now(timezone.utc)
   548	        record = UISurfaceRecord(
   549	            surface_id=surface_id,
   550	            kind=UISurfaceKind(kind),
   551	            title=title,
   552	            envelope=envelope_dump,
   553	            catalog_id=envelope_model.catalog_id,
   554	            agent_id=agent_id,

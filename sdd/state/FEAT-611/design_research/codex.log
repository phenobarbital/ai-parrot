   109	    async def validate_for_persistence(self, envelope: CreateSurface, *, owner_pctx: "PermissionContext") -> None:
   110	        """No-op for baked envelopes (AC11); for linked ones: TOOL-origin validation + guard + owner check (AC14)."""
   111	        # function-local: linked/ must never import catalog/ at module import time (spec §7 one-way rule)
   112	        from parrot.outputs.a2ui.catalog import ProducerOrigin, validate_envelope
   113	
   114	        if not has_data_sources(envelope):
   115	            return
   116	        validate_envelope(envelope, origin=ProducerOrigin.TOOL)  # raises CatalogValidationError (→ 422 at caller)
   117	        await self._assert_sources_allowed(_sources(envelope), owner_pctx)
   118	
   119	    async def ensure_snapshot(self, envelope: dict[str, Any], *, owner_pctx: "PermissionContext") -> dict[str, Any]:
   120	        """Execute once (owner ctx) when any target lacks rows/snapshot_at; raise SnapshotError on any failure."""
   121	        from parrot.outputs.a2ui.linked.executor import ERROR_STATUS, execute_sources
   122	
   123	        if not has_data_sources(envelope):
   124	            return envelope
   125	        sources = _sources(envelope)
   126	        self._require_guard()
   127	        await self._assert_sources_allowed(sources, owner_pctx)
   128	
   129	        data_model = envelope.get("dataModel") or {}
   130	
   131	        def _has_snapshot(key: str, src: LinkedDataSource) -> bool:
   132	            root = data_model.get(key)
   133	            rows = root.get("rows") if isinstance(root, Mapping) else None
   134	            return src.snapshot_at is not None and isinstance(rows, list)
   135	
   136	        if sources and all(_has_snapshot(key, src) for key, src in sources.items()):
   137	            return envelope
   138	
   139	        outcome = await execute_sources(
   140	            sources,
   141	            pctx=owner_pctx,
   142	            guard=self.guard,
   143	            max_snapshot_rows=self.max_snapshot_rows,
   144	            max_fetch_rows=self.max_fetch_rows,
   145	        )
   146	        for key in sources:
   147	            result = outcome.outcomes.get(key)
   148	            if result is not None and result.error is not None:
   149	                raise SnapshotError(ERROR_STATUS.get(result.error, 502), result.error)
   150	        return _patch(copy.deepcopy(envelope), outcome)
   151	
   152	    async def refresh(
   153	        self, envelope: dict[str, Any], *, params: Mapping[str, Any], owner_pctx: "PermissionContext"
   154	    ) -> RefreshOutcome:
   155	        """Re-authorise, execute with overrides, patch successful sources; never persists (S11)."""
   156	        from parrot.outputs.a2ui.linked.executor import ERROR_STATUS, execute_sources
   157	
   158	        sources = _sources(envelope)
   159	        await self._assert_sources_allowed(sources, owner_pctx)
   160	
   161	        # `params` is the flat RefreshSurfaceRequest.params dict: a key naming a source with a mapping value is
   162	        # that source's overrides; every other key (and any mapping-valued key that does NOT name a source) is
   163	        # broadcast to every source (execute_sources ignores names a source does not declare / has locked).
   164	        broadcast: dict[str, Any] = {}
   165	        per_source: dict[str, dict[str, Any]] = {key: {} for key in sources}
   166	        for name, value in params.items():
   167	            if name in sources and isinstance(value, Mapping):
   168	                per_source[name].update(value)
   169	            else:
   170	                broadcast[name] = value
   171	        param_overrides = {key: {**broadcast, **per_source[key]} for key in sources}
   172	
   173	        outcome = await execute_sources(
   174	            sources,
   175	            param_overrides=param_overrides,
   176	            pctx=owner_pctx,
   177	            guard=self.guard,
   178	            max_snapshot_rows=self.max_snapshot_rows,
   179	            max_fetch_rows=self.max_fetch_rows,
   180	        )
   181	
   182	        patched = _patch(copy.deepcopy(envelope), outcome)
   183	
   184	        warnings: list[str] = []
   185	        for key, result in outcome.outcomes.items():
   186	            if result.error is not None:
   187	                warnings.append(f"source {key}: {result.error}")
   188	            if result.ignored_params:
   189	                warnings.append(f"source {key}: ignored params {sorted(result.ignored_params)}")
   190	
   191	        error_status: int | None = None
   192	        error_code: str | None = None
   193	        if sources and all(result.error is not None for result in outcome.outcomes.values()):
   194	            first_key = next(iter(sources))
   195	            first_result = outcome.outcomes[first_key]
   196	            error_code = first_result.error
   197	            error_status = ERROR_STATUS.get(error_code, 502)
   198	
   199	        stamps = [result.snapshot_at for result in outcome.outcomes.values() if result.snapshot_at is not None]
   200	        snapshot_at = max(stamps) if stamps else None
   201	
   202	        return RefreshOutcome(
   203	            envelope=patched,
   204	            snapshot_at=snapshot_at,
   205	            warnings=warnings,
   206	            error_status=error_status,
   207	            error_code=error_code,
   208	        )
   209	
   210	
   211	def _patch(envelope: dict[str, Any], outcome: "ExecutionOutcome") -> dict[str, Any]:
   212	    """Write rows into dataModel[<root>] and stamp snapshot_at/snapshot_truncated on each successful source."""
   213	    data_model = envelope.setdefault("dataModel", {})
   214	    for key, patch in outcome.data_model_patch().items():
   215	        existing = data_model.get(key)
   216	        if isinstance(existing, Mapping):
   217	            data_model[key] = {**existing, **patch}
   218	        else:
   219	            data_model[key] = patch
   220	
   221	    metadata = envelope.get("metadata")
   222	    extensions = metadata.get("extensions") if isinstance(metadata, Mapping) else None
   223	    sources = extensions.get(_EXT_KEY) if isinstance(extensions, Mapping) else None
   224	    if isinstance(sources, Mapping):
   225	        for key, result in outcome.outcomes.items():
   226	            if result.error is None and key in sources:
   227	                sources[key]["snapshot_at"] = result.snapshot_at.isoformat() if result.snapshot_at else None
   228	                sources[key]["snapshot_truncated"] = result.truncated
   229	    return envelope


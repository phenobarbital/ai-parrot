   430	    async def _resolve_surface_for_access(
   431	        self,
   432	        surface_id: str,
   433	        user_id: str | None,
   434	        token: str | None,
   435	        scope: SurfaceScope | None = None,
   436	    ) -> tuple[UISurfaceRecord | None, web.Response | None]:
   437	        """Resolve owner-or-scope-or-share access to a surface.
   438	
   439	        Thin wrapper building this handler's OWN ``web.Response`` from the
   440	        SHARED :func:`resolve_surface_access` rule set (module-level —
   441	        also used by ``A2UIHandler``'s mirror route, TASK-2703/2935 — so the
   442	        rule set cannot drift between the two routes).
   443	
   444	        Returns:
   445	            ``(record, None)`` on success, or ``(None, error_response)``.
   446	        """
   447	        record, error = await resolve_surface_access(self.store, surface_id, user_id, token, scope=scope)
   448	        if error is None:
   449	            return record, None
   450	        message, status = error
   451	        # self._error() always builds the response directly via
   452	        # json_response — never BaseView.error() and its status whitelist
   453	        # landmine (see _error's own docstring) — so any status works here,
   454	        # including 410 (NOT in that whitelist).
   455	        return None, self._error(message, status=status)

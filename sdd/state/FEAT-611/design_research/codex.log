   222	@_register("group_by")
   223	def _op_group_by(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   224	    """Aggregate non-null groups while preserving their first-appearance order."""
   225	    by = list(op.by)
   226	    aggregate = dict(op.aggregate)
   227	    _require_columns(frame, by + list(aggregate), index, "group_by")
   228	    out = frame.groupby(by, sort=False, dropna=True).agg({column: _AGGS[fn] for column, fn in aggregate.items()})
   229	    return out.reset_index()[by + list(aggregate)]

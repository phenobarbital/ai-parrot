    72	  // HTML fallback — today's behaviour, byte-identical when the flag is off
    73	  // or no envelope/root is present (output_mode "infographic" always falls
    74	  // through to here in that case; output_mode "a2ui" falls through only
    75	  // when it DOES have an Infographic root but the flag is off).
    76	  if (inlineHtml.includes('<html') || inlineHtml.includes('<!DOCTYPE')) {
    77	    return { mode: 'html', html: inlineHtml, ...common };
    78	  }

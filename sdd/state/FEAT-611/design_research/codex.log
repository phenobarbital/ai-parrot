   477	def _validate_axes(component: dict[str, Any], sources: Mapping[str, Any], frames: Mapping[str, Any]) -> None:
   478	    """Check bound component axes and columns against their source frames."""
   479	    import pandas as pd
   480	
   481	    component_type = component.get("component")
   482	    binding = component.get("data") if component_type in {"Chart", "DataTable"} else component.get("value")
   483	    rows_key = _rows_key(binding, sources)
   484	    if rows_key is None:
   485	        return
   486	    key, value_column = rows_key
   487	    if key not in frames:
   488	        raise ValueError(f"source '{key}' has no frame")
   489	    frame = frames[key]
   490	    columns = list(frame.columns)
   491	
   492	    def validate_column(prop: str, column: Any, *, numeric: bool = False) -> None:
   493	        if not isinstance(column, str) or column not in frame.columns:
   494	            raise ValueError(f"{prop} '{column}' not in source '{key}' columns {columns}")
   495	        if numeric and not (pd.api.types.is_numeric_dtype(frame[column]) or pd.api.types.is_bool_dtype(frame[column])):
   496	            raise ValueError(f"{prop} '{column}' in source '{key}' is not numeric (dtype {frame[column].dtype})")
   497	
   498	    if component_type == "Chart":
   499	        validate_column("x", component.get("x"))
   500	        y_values = component.get("y")
   501	        if isinstance(y_values, str):
   502	            y_values = [y_values]
   503	        if isinstance(y_values, list):
   504	            for column in y_values:
   505	                validate_column("y", column, numeric=True)
   506	    elif component_type == "DataTable":
   507	        for column in component.get("columns", []):
   508	            if isinstance(column, Mapping):
   509	                validate_column("columns.name", column.get("name"))
   510	    elif component_type == "KPICard" and value_column is not None:
   511	        validate_column("value", value_column)

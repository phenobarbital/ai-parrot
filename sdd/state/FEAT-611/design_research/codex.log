   193	                "publish_surface requires the ai-parrot-server package (for "
   194	                "PgUISurfaceStore/UISurfaceRecord/UISurfaceKind) when no "
   195	                "mixin-composed bot is bound. Install/enable ai-parrot-server, "
   196	                "or pass surface_store= to the tool constructor."
   197	            ) from exc
   198	
   199	        envelope_model = CreateSurface.model_validate(envelope)
   200	        # Code-review fix: ALWAYS mint a fresh UUID for the row's primary
   201	        # key — never reuse envelope_model.surface_id, which is a
   202	        # renderer-scoped identifier and very often NOT a UUID at all (e.g.
   203	        # every recipe-backed envelope's surfaceId is
   204	        # f"{recipe.name}-infographic"). Matches the mixin's identical fix
   205	        # and UISurfacesHandler._pin_save's established convention.
   206	        surface_id = str(uuid.uuid4())
   207	        store = self._surface_store if self._surface_store is not None else PgUISurfaceStore()
   208	        agent_id = self._agent_id or "publish_surface_tool"
   209	        user_id = self._user_id or agent_id
   210	
   211	        envelope_dump = envelope_model.model_dump(by_alias=True, mode="json")
   212	        if has_data_sources(envelope_model):
   213	            # FEAT-598 S1/S2: the persistence boundary for linked envelopes — TOOL-origin validation, a mandatory
   214	            # (fail-closed) data-plane guard, and a save-time snapshot executed ONCE in the owner's context.
   215	            from parrot.outputs.a2ui.linked.service import LinkedSurfaceService
   216	
   217	            service = self._linked_service or LinkedSurfaceService(guard=None)
   218	            owner_pctx = self._current_pctx or build_principal_context(user_id, channel="ui_surfaces")
   219	            await service.validate_for_persistence(envelope_model, owner_pctx=owner_pctx)
   220	            envelope_dump = await service.ensure_snapshot(envelope_dump, owner_pctx=owner_pctx)
   221	
   222	        now = datetime.now(UTC)
   223	        record = UISurfaceRecord(
   224	            surface_id=surface_id,
   225	            kind=UISurfaceKind(kind),
   226	            title=title,
   227	            envelope=envelope_dump,
   228	            catalog_id=envelope_model.catalog_id,
   229	            agent_id=agent_id,
   230	            user_id=user_id,
   231	            session_id=self._session_id,
   232	            recipe_name=recipe_name,
   233	            recipe_owner=recipe_owner,
   234	            recipe_params=recipe_params or {},
   235	            created_at=now,
   236	            updated_at=now,
   237	        )

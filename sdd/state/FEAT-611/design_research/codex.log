     2	import { postQuery, queryUrl, QuerySourceHttpError } from '$lib/api/querysource';
     3	import type { LinkedDataSource, Row } from './types';
     4	
     5	/** Raised for every QuerySource 404 — the UI says "unavailable", NEVER "denied" (spec §7 risks). */
     6	export class SourceUnavailable extends Error {
     7	  constructor(public readonly slug: string) {
     8	    super(`source '${slug}' unavailable`);
     9	    this.name = 'SourceUnavailable';
    10	  }
    11	}
    12	
    13	export const DEFAULT_MAX_FETCH_ROWS = 5000;
    14	
    15	/**
    16	 * Normalise a QuerySource JSON payload to a single row array (S4, same rule as the Python
    17	 * `QuerySlugSource._select_multi_frame`): a plain array is already the single frame (the
    18	 * server unwraps a one-frame MultiQuery result before serializing); a keyed object selects
    19	 * `src.multi_output` when set, else `'result'`, else the sole key when there is exactly one.
    20	 * Anything else (ambiguous multi-frame with no selector, or an unexpected shape) yields `[]`.
    21	 */
    22	function selectFrame(payload: unknown, src: LinkedDataSource): Row[] {
    23	  if (Array.isArray(payload)) return payload as Row[];
    24	  if (payload && typeof payload === 'object') {
    25	    const frames = payload as Record<string, unknown>;
    26	    const keys = Object.keys(frames);
    27	    let selected: unknown;
    28	    if (src.multi_output && Object.prototype.hasOwnProperty.call(frames, src.multi_output)) {
    29	      selected = frames[src.multi_output];
    30	    } else if (Object.prototype.hasOwnProperty.call(frames, 'result')) {
    31	      selected = frames['result'];
    32	    } else if (keys.length === 1) {
    33	      selected = frames[keys[0]];
    34	    } else {
    35	      selected = [];
    36	    }
    37	    return Array.isArray(selected) ? (selected as Row[]) : [];
    38	  }
    39	  return [];
    40	}
    41	
    42	export async function fetchSource(
    43	  src: LinkedDataSource,
    44	  conditions: Record<string, unknown>,
    45	  opts: { baseUrl: string; headers: HeadersInit; maxFetchRows?: number },
    46	): Promise<Row[]> {
    47	  const cap = opts.maxFetchRows ?? DEFAULT_MAX_FETCH_ROWS;
    48	  // deriveConditions never emits `limit` (TASK-3770/TASK-3793); the lane re-applies request.limit bounded by the cap (S8/AC17)
    49	  const body: Record<string, unknown> = { ...conditions, querylimit: Math.min(src.request.limit ?? cap, cap) };
    50	  if (body.refresh !== true) delete body.refresh;
    51	  let payload: unknown;
    52	  try {
    53	    payload = await postQuery(queryUrl(opts.baseUrl, src.slug, src.tenant ?? null), body, opts.headers);
    54	  } catch (err) {
    55	    if (err instanceof QuerySourceHttpError && err.status === 404) throw new SourceUnavailable(src.slug);
    56	    throw err;
    57	  }
    58	  return selectFrame(payload, src);
    59	}


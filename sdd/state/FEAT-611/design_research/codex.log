    78	
    79	    seen: set[int] = set()
    80	    current: BaseException | None = exc
    81	    depth = 0
    82	    while current is not None and depth < _MAX_CAUSE_DEPTH and id(current) not in seen:
    83	        seen.add(id(current))
    84	        if isinstance(current, QueryAccessDenied):
    85	            # FEAT-150: a "missing" or "denied" principal both collapse to the same not-found code.
    86	            return 404, "query_not_found"
    87	        if isinstance(current, TenantError):

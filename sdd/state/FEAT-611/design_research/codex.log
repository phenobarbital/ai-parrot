     1	"""PBAC (Policy-Based Access Control) setup and initialization for AI-Parrot.
     2	
     3	This module provides the ``setup_pbac()`` async helper that boots the full
     4	PBAC stack during application startup and wires it into the aiohttp app.
     5	
     6	Typical usage in app.py::
     7	
     8	    from parrot.auth.pbac import setup_pbac
     9	
    10	    pdp, evaluator, guardian = setup_pbac(app, policy_dir="policies")
    11	    if evaluator is not None:
    12	        resolver = PBACPermissionResolver(evaluator=evaluator)
    13	        bot_manager.set_default_resolver(resolver)
    14	
    15	Public API:
    16	    - ``setup_pbac``: Initialize PBAC engine from YAML policies directory.
    17	    - ``setup_dataplane_guard``: Build the default FEAT-598
    18	      ``DataPlanePolicyGuard`` and register it as ``app["dataplane_guard"]``
    19	      when PBAC can initialize; leaves the key unset otherwise.
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import logging
    25	from pathlib import Path
    26	from typing import Optional, TYPE_CHECKING
    27	
    28	from aiohttp import web
    29	
    30	from parrot.conf import PARROT_SAAS_MODE
    31	from parrot.auth.dataplane_guard import DataPlanePolicyGuard
    32	from parrot.auth.rls_registry import RlsRegistry
    33	
    34	if TYPE_CHECKING:
    35	    from navigator_auth.abac.pdp import PDP
    36	    from navigator_auth.abac.guardian import Guardian
    37	    from navigator_auth.abac.policies.evaluator import PolicyEvaluator
    38	
    39	logger = logging.getLogger("parrot.auth.pbac")
    40	
    41	
    42	def _fail_open_or_closed(
    43	    reason: str,
    44	) -> "tuple[Optional[PDP], Optional[PolicyEvaluator], Optional[Guardian]]":
    45	    """Return the fail-open triple, or raise, depending on ``PARROT_SAAS_MODE``.
    46	
    47	    Centralizes the fail-open vs fail-closed decision so every failure path
    48	    in :func:`setup_pbac` behaves consistently: legacy deployments
    49	    (``PARROT_SAAS_MODE=false``) keep returning ``(None, None, None)``;
    50	    SaaS deployments (``PARROT_SAAS_MODE=true``) raise ``RuntimeError``
    51	    naming the original failure cause instead of silently degrading to an
    52	    unprotected default resolver.
    53	
    54	    Args:
    55	        reason: Human-readable description of the failure cause, included
    56	            verbatim in the raised ``RuntimeError`` message.
    57	
    58	    Returns:
    59	        ``(None, None, None)`` when ``PARROT_SAAS_MODE`` is false.
    60	
    61	    Raises:
    62	        RuntimeError: When ``PARROT_SAAS_MODE`` is true.
    63	    """
    64	    if PARROT_SAAS_MODE:
    65	        raise RuntimeError(f"PBAC initialization failed with PARROT_SAAS_MODE=true " f"(fail-closed): {reason}")
    66	    return None, None, None
    67	
    68	
    69	def setup_pbac(
    70	    app: web.Application,
    71	    policy_dir: str = "policies",
    72	    cache_ttl: int = 30,
    73	    default_effect: Optional[object] = None,
    74	) -> "tuple[Optional[PDP], Optional[PolicyEvaluator], Optional[Guardian]]":
    75	    """Initialize the PBAC engine and register it with the aiohttp application.
    76	
    77	    Performs the following steps:
    78	    1. Validates that the policy directory exists.
    79	    2. Creates a ``YAMLStorage`` pointing at that directory.
    80	    3. Creates ``PolicyEvaluator`` with short TTL cache (default 30s) for
    81	       time-dependent policy freshness.
    82	    4. Loads YAML policies via ``PolicyLoader.load_from_directory()``.
    83	    5. Creates ``PDP(storage=yaml_storage)`` and attaches the evaluator.
    84	    6. Calls ``PDP.setup(app)`` which registers:
    85	       - ``app['security']`` → ``Guardian`` instance
    86	       - ``app['abac']`` → ``PDP`` instance
    87	       - ABAC middleware
    88	       - ``POST /api/v1/abac/check`` (and other ABAC endpoints)
    89	
    90	    Graceful degradation (legacy / ``PARROT_SAAS_MODE=false``): if
    91	    *policy_dir* does not exist, the imports fail (navigator-auth not
    92	    installed), or policy/PDP initialization raises, the function logs a
    93	    warning/error and returns ``(None, None, None)``.  The application
    94	    continues running with the existing default resolver (fail-open).
    95	
    96	    Fail-closed (``PARROT_SAAS_MODE=true``): the same failure conditions
    97	    instead raise ``RuntimeError`` (with the original failure cause in the
    98	    message) so a misconfigured SaaS deployment fails loudly at startup
    99	    instead of silently degrading to an unprotected default resolver.
   100	
   101	    Args:
   102	        app: The aiohttp ``web.Application`` to register PBAC into.
   103	        policy_dir: Path to directory containing ``*.yaml`` policy files.
   104	            Defaults to ``"policies"`` (relative to the working directory).

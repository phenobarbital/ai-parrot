   127	    elif op.operator == "ne":
   128	        matches = series != op.value
   129	    elif op.operator == "gt":
   130	        matches = series > op.value
   131	    elif op.operator == "ge":
   132	        matches = series >= op.value
   133	    elif op.operator == "lt":
   134	        matches = series < op.value
   135	    elif op.operator == "le":
   136	        matches = series <= op.value
   137	    elif op.operator == "in":

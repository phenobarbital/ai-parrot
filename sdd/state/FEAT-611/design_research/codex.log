   204	@_register("derive")
   205	def _op_derive(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   206	    """Add a column calculated from a declarative numeric binary expression."""
   207	    out = frame.copy()
   208	    out[op.name] = _derive_operand(out, op.expr, index)
   209	    return out

   526	        store = surface_store if surface_store is not None else getattr(self, "_surface_store", None)
   527	        if store is None:
   528	            store = PgUISurfaceStore()
   529	
   530	        agent_id = getattr(self, "name", None) or "unknown-agent"
   531	        resolved_user_id = user_id or getattr(self, "user_id", None) or agent_id

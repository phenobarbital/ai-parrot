   246	@_register("join")
   247	def _op_join(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   248	    """Join a sibling frame without allowing null keys to match each other."""
   249	    import pandas as pd
   250	
   251	    right = _sibling(frames, op.with_, index, "join")
   252	    left_keys = [pair.left for pair in op.on]
   253	    right_keys = [pair.right for pair in op.on]
   254	    _require_columns(frame, left_keys, index, "join")
   255	    _require_columns(right, right_keys, index, "join")
   256	
   257	    same_named_keys = {
   258	        right_key for left_key, right_key in zip(left_keys, right_keys, strict=True) if left_key == right_key
   259	    }
   260	    right_output = [column for column in right.columns if column not in same_named_keys]
   261	    renamed = {column: f"{op.with_}_{column}" for column in right_output if column in frame.columns}
   262	    right_work = right.rename(columns=renamed).copy()
   263	    merge_right_keys = [renamed.get(column, column) for column in right_keys]
   264	    output_right = [renamed.get(column, column) for column in right_output]
   265	
   266	    order_column = "__parrot_join_order"
   267	    while order_column in frame.columns or order_column in right_work.columns:
   268	        order_column = f"_{order_column}"
   269	    left_work = frame.copy()
   270	    left_work[order_column] = range(len(left_work))
   271	    valid_left = left_work[left_work[left_keys].notna().all(axis=1)]
   272	    valid_right = right_work[right_work[merge_right_keys].notna().all(axis=1)]
   273	    merged = valid_left.merge(
   274	        valid_right,
   275	        how=op.how,
   276	        left_on=left_keys,
   277	        right_on=merge_right_keys,
   278	        sort=False,
   279	    )
   280	
   281	    if op.how == "left":
   282	        null_left = left_work[~left_work[left_keys].notna().all(axis=1)].copy()
   283	        for column in output_right:
   284	            null_left[column] = pd.NA
   285	        merged = pd.concat([merged, null_left], ignore_index=True, sort=False)
   286	
   287	    columns = list(frame.columns) + output_right
   288	    return merged.sort_values(order_column, kind="mergesort")[columns].reset_index(drop=True)

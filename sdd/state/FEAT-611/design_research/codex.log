    97	def _execution_order(sources: Mapping[str, LinkedDataSource]) -> tuple[list[str], dict[str, str]]:
    98	    """Topological order (join.with / union.sources first). Returns (order, failed{key: code})."""
    99	    deps: dict[str, list[str]] = {}
   100	    for key, src in sources.items():
   101	        refs: list[str] = []
   102	        if src.transform is not None and src.transform.ops:
   103	            for op in src.transform.ops:
   104	                if isinstance(op, Join):
   105	                    refs.append(op.with_)
   106	                elif isinstance(op, Union_):
   107	                    refs.extend(op.sources)
   108	        deps[key] = refs
   109	
   110	    failed: dict[str, str] = {}
   111	    for key, refs in deps.items():
   112	        if any(ref not in sources for ref in refs):
   113	            failed[key] = "data_stage"
   114	
   115	    # Propagate failure to any (transitive) dependent of an already-failed sibling.
   116	    changed = True
   117	    while changed:
   118	        changed = False
   119	        for key, refs in deps.items():
   120	            if key in failed:
   121	                continue
   122	            if any(ref in failed for ref in refs):
   123	                failed[key] = "data_stage"
   124	                changed = True
   125	
   126	    # Kahn's algorithm (stable insertion order) over the remaining, non-failed sources.
   127	    pending = [key for key in sources if key not in failed]
   128	    indegree = {key: sum(1 for ref in deps[key] if ref not in failed) for key in pending}
   129	    dependents: dict[str, list[str]] = {key: [] for key in pending}
   130	    for key in pending:
   131	        for ref in deps[key]:
   132	            if ref in dependents:
   133	                dependents[ref].append(key)
   134	
   135	    order: list[str] = []
   136	    ready = [key for key in pending if indegree[key] == 0]
   137	    while ready:
   138	        ready.sort(key=pending.index)  # stable: earliest-inserted ready key first
   139	        key = ready.pop(0)
   140	        order.append(key)
   141	        for dep in dependents[key]:
   142	            indegree[dep] -= 1
   143	            if indegree[dep] == 0:
   144	                ready.append(dep)
   145	
   146	    for key in pending:
   147	        if key not in order:
   148	            failed[key] = "data_stage"  # part of a cycle
   149	
   150	    return order, failed

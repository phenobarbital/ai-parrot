   466	    async def _get_list(self, user_id: str | None, scope: SurfaceScope) -> web.Response:
   467	        if not user_id:
   468	            return self._error("User ID not found in session", status=401)
   469	        qs = self.query_parameters(self.request)
   470	        kind_str = qs.get("kind")
   471	        kind: UISurfaceKind | None = None
   472	        if kind_str:
   473	            try:
   474	                kind = UISurfaceKind(kind_str)
   475	            except ValueError:
   476	                return self._error(f"Unknown kind: {kind_str!r}", status=400)
   477	
   478	        visible = await self.store.list_visible(scope, kind=kind)
   479	        shared = await self.store.list_shared_with(user_id)
   480	        if kind is not None:
   481	            shared = [r for r in shared if r.kind == kind]
   482	
   483	        items = self._tag_and_merge(user_id, visible, shared)
   484	        return self.json_response({"status": "success", "count": len(items), "surfaces": items})
   485	
   486	    def _tag_and_merge(
   487	        self, user_id: str | None, visible: list[UISurfaceRecord], shared: list[UISurfaceRecord]
   488	    ) -> list[dict[str, Any]]:
   489	        """Dedupe ``visible`` (owner ∪ tenant ∪ group ∪ superuser) with
   490	        ``shared`` (token-claimed) by ``surface_id``, tagging ``access``.
   491	
   492	        A surface both token-shared and tenant/group-visible is reported
   493	        ONCE, tagged by the ``visible`` pass — "visible wins over shared,
   494	        owner wins over both" (spec §7 Known Risk).
   495	        """
   496	        tagged: dict[str, dict[str, Any]] = {}
   497	        for record in visible:
   498	            access = "owner" if record.user_id == user_id else "tenant"
   499	            tagged[record.surface_id] = {**_surface_metadata(record), "access": access}
   500	        for record in shared:
   501	            if record.surface_id in tagged:
   502	                continue
   503	            tagged[record.surface_id] = {**_surface_metadata(record), "access": "shared"}
   504	        return list(tagged.values())

   153	def _conditions_for(
   154	    src: LinkedDataSource, overrides: Mapping[str, Any], *, max_fetch_rows: int
   155	) -> tuple[dict[str, Any], list[str]]:
   156	    """derive_conditions(request, locked) with non-locked overrides + {'querylimit': min(request.limit or cap, cap)}.
   157	
   158	    ``derive_conditions`` never emits ``limit`` (TASK-3770: ``build_conditions`` folds it into the lane-time ``querylimit``),
   159	    so the executor re-applies ``request.limit`` here, bounded by ``max_fetch_rows`` (S8/AC17).
   160	    """
   161	    locked_values = {k: src.conditions[k] for k in src.locked if k in src.conditions}
   162	    ignored = sorted(k for k in overrides if k in src.locked)
   163	    allowed = {k: v for k, v in overrides.items() if k not in src.locked}
   164	    # Conditions are always DERIVED from request (S5): fold declared, non-locked overrides into
   165	    # request.placeholders; names not declared in src.params are ALSO ignored (never hand-merged in).
   166	    declared = {k: v for k, v in allowed.items() if k in src.params}
   167	    not_declared = [k for k in allowed if k not in src.params]
   168	    if not_declared:
   169	        ignored = sorted(set(ignored) | set(not_declared))
   170	    request = (
   171	        src.request.model_copy(update={"placeholders": {**src.request.placeholders, **declared}})
   172	        if declared
   173	        else src.request
   174	    )
   175	    conditions = derive_conditions(request, locked=locked_values)
   176	    conditions["querylimit"] = min(request.limit or max_fetch_rows, max_fetch_rows)  # S8: QuerySource caps the fetch
   177	    return conditions, ignored

    29		/** Serialize CanvasBlock[] to text for audio generation */
    30		function serializeBlocksToText(blocks: CanvasBlock[]): string {
    31			return blocks
    32				.map((block) => {
    33					if (block.type === 'markdown') return (block.data as MarkdownBlockData).content;
    34					if (block.type === 'chart') {
    35						const d = block.data as ChartBlockData;
    36						return `[Chart: ${d.config.title || 'Untitled'}]\n${JSON.stringify(d.data)}`;
    37					}
    38					if (block.type === 'table') {
    39						return `[Table]\n${JSON.stringify((block.data as TableBlockData).rows)}`;
    40					}
    41					if (block.type === 'title') {
    42						const d = block.data as TitleBlockData;
    43						return [d.title, d.subtitle].filter(Boolean).join('\n');
    44					}
    45					if (block.type === 'summary') {
    46						const d = block.data as SummaryBlockData;
    47						return [d.title, d.content].filter(Boolean).join('\n');
    48					}
    49					if (block.type === 'quote') {
    50						const d = block.data as QuoteBlockData;
    51						return `"${d.text}"${d.author ? ` — ${d.author}` : ''}`;
    52					}
    53					if (block.type === 'callout') {
    54						const d = block.data as CalloutBlockData;
    55						return [d.title, d.content].filter(Boolean).join(': ');
    56					}
    57					if (block.type === 'bullet_list') {
    58						const d = block.data as BulletListBlockData;
    59						const header = d.title ? `${d.title}\n` : '';
    60						return header + d.items.filter(i => i.trim()).map(i => `• ${i}`).join('\n');
    61					}
    62					if (block.type === 'hero_card') {
    63						const d = block.data as HeroCardBlockData;
    64						return `${d.label}: ${d.value}`;
    65					}
    66					return '';
    67				})
    68				.filter(Boolean)
    69				.join('\n\n---\n\n');
    70		}

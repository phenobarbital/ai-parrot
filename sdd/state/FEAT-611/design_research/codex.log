   172	def _derive_operand(frame: "pd.DataFrame", expr: Any, index: int) -> Any:
   173	    """Evaluate one numeric derive operand without interpreting arbitrary code."""
   174	    import pandas as pd
   175	
   176	    if isinstance(expr, str):
   177	        _require_columns(frame, [expr], index, "derive")
   178	        series = frame[expr]
   179	        if not pd.api.types.is_numeric_dtype(series) or pd.api.types.is_bool_dtype(series):
   180	            raise TransformError(None, index, f"derive: column {expr!r} is not numeric")
   181	        return series
   182	    if isinstance(expr, (int, float)) and not isinstance(expr, bool):
   183	        return expr
   184	
   185	    left = _derive_operand(frame, expr.left, index)
   186	    right = _derive_operand(frame, expr.right, index)
   187	    if expr.operator == "+":
   188	        return left + right
   189	    if expr.operator == "-":
   190	        return left - right
   191	    if expr.operator == "*":
   192	        return left * right
   193	    if expr.operator == "/":
   194	        if isinstance(right, pd.Series):
   195	            return left / right.mask(right == 0)
   196	        if right == 0:
   197	            if isinstance(left, pd.Series):
   198	                return pd.Series(float("nan"), index=left.index)
   199	            return None
   200	        return left / right
   201	    raise TransformError(None, index, f"derive: unsupported operator {expr.operator!r}")
   202	

   117	@_register("filter")
   118	def _op_filter(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   119	    """Filter non-null values using one declared comparison operator."""
   120	    if frame.empty and op.column not in frame.columns:
   121	        return frame.copy()

     1	/**
     2	 * Canvas Tab Manager — runes-based state for the canvas tab system.
     3	 */
     4	import { v4 as uuidv4 } from "uuid";
     5	
     6	export type CanvasTabType =
     7	  | "markdown"
     8	  | "chart"
     9	  | "spreadsheet"
    10	  | "infographic"
    11	  | "audio"
    12	  | "interactive";
    13	
    14	export interface CanvasTab {
    15	  id: string;
    16	  type: CanvasTabType;
    17	  title: string;
    18	  data: unknown;
    19	  closable: boolean;
    20	}
    21	
    22	const MAIN_CANVAS_ID = "main-canvas";
    23	
    24	let tabs = $state<CanvasTab[]>([]);
    25	let activeTabId = $state<string | null>(null);
    26	
    27	function ensureMainCanvas() {
    28	  if (tabs.length === 0) {
    29	    tabs.push({
    30	      id: MAIN_CANVAS_ID,
    31	      type: "markdown",
    32	      title: "Main Canvas",
    33	      data: [], // FEAT-034: empty CanvasBlock[] instead of string
    34	      closable: false,
    35	    });
    36	    activeTabId = MAIN_CANVAS_ID;
    37	  }
    38	}
    39	
    40	export function getTabs(): CanvasTab[] {
    41	  return tabs;
    42	}
    43	
    44	export function getActiveTabId(): string | null {
    45	  return activeTabId;
    46	}
    47	
    48	export function getActiveTab(): CanvasTab | undefined {
    49	  return tabs.find((t) => t.id === activeTabId);
    50	}
    51	
    52	export function initCanvas() {
    53	  ensureMainCanvas();
    54	}
    55	
    56	export function addTab(
    57	  type: CanvasTabType,
    58	  title: string,
    59	  data: unknown = null,
    60	): string {
    61	  const id = uuidv4();
    62	  tabs.push({ id, type, title, data, closable: true });
    63	  activeTabId = id;
    64	  return id;
    65	}
    66	
    67	export function removeTab(id: string) {
    68	  const tab = tabs.find((t) => t.id === id);
    69	  if (!tab || !tab.closable) return;
    70	
    71	  const idx = tabs.findIndex((t) => t.id === id);
    72	  tabs.splice(idx, 1);
    73	
    74	  if (activeTabId === id) {
    75	    // Activate the previous tab, or first tab
    76	    const newIdx = Math.min(idx, tabs.length - 1);
    77	    activeTabId = tabs[newIdx]?.id ?? null;
    78	  }
    79	}
    80	
    81	export function setActiveTab(id: string) {
    82	  if (tabs.find((t) => t.id === id)) {
    83	    activeTabId = id;
    84	  }
    85	}
    86	
    87	export function updateTabData(id: string, data: unknown) {
    88	  const tab = tabs.find((t) => t.id === id);
    89	  if (tab) {
    90	    tab.data = data;
    91	  }
    92	}
    93	
    94	export function updateTabTitle(id: string, title: string) {
    95	  const tab = tabs.find((t) => t.id === id);
    96	  if (tab && tab.closable) {
    97	    tab.title = title;
    98	  }
    99	}
   100	
   101	export function resetCanvas() {
   102	  tabs.length = 0;
   103	  activeTabId = null;
   104	}


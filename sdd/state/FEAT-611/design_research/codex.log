   291	@_register("union")
   292	def _op_union(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   293	    """Concatenate the own and sibling frames on their ordered column intersection."""
   294	    import pandas as pd
   295	
   296	    others = [_sibling(frames, key, index, "union") for key in op.sources]
   297	    columns = [column for column in frame.columns if all(column in other.columns for other in others)]
   298	    return pd.concat([frame[columns], *(other[columns] for other in others)], ignore_index=True)


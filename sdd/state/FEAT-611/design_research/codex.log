   460	def _rows_key(binding: Any, sources: Mapping[str, Any]) -> tuple[str, str | None] | None:
   461	    """Return the source key and optional column from a rows binding."""
   462	    if not isinstance(binding, Mapping):
   463	        return None
   464	    path = binding.get("path")
   465	    if not isinstance(path, str) or not path.startswith("/"):
   466	        return None
   467	    tokens = path[1:].split("/")
   468	    if len(tokens) < 2 or tokens[1] != "rows" or tokens[0] not in sources:
   469	        return None
   470	    if len(tokens) == 2:
   471	        return tokens[0], None
   472	    if len(tokens) == 4 and tokens[2] == "0":
   473	        return tokens[0], tokens[3]
   474	    return None

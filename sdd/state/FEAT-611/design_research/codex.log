    19	/** The minimal shape `buildInfographicTabData` needs from an `AgentMessage`. */
    20	export interface InfographicMessageLike {
    21	  output_mode?: string;
    22	  output?: unknown;
    23	  metadata?: {
    24	    html_inline_omitted?: unknown;
    25	    html_url?: unknown;
    26	    template_name?: unknown;
    27	    theme?: unknown;
    28	  } | null;
    29	  a2ui_envelope?: A2UIEnvelope;
    30	}
    31	
    32	/**
    33	 * Decide the `InfographicTabData` (if any) `maybeOpenInfographicCanvas`
    34	 * should open for `message`, given the current `features.a2ui` value.
    35	 *
    36	 * @param message - The assistant `AgentMessage` (or a message-shaped object).
    37	 * @param features - Only `a2ui` is read; passed explicitly (not imported)
    38	 *   so this stays a pure function.
    39	 * @returns The tab data, or `null` when no canvas tab should open.
    40	 */
    41	export function buildInfographicTabData(
    42	  message: InfographicMessageLike,
    43	  features: { a2ui: boolean },
    44	): InfographicTabData | null {
    45	  if (message.output_mode !== 'infographic' && message.output_mode !== 'a2ui') return null;
    46	
    47	  const meta = message.metadata;
    48	  const inlineHtml =
    49	    !meta?.html_inline_omitted && typeof message.output === 'string' ? message.output : '';
    50	  const url = typeof meta?.html_url === 'string' ? meta.html_url : undefined;
    51	  const template = typeof meta?.template_name === 'string' ? meta.template_name : undefined;
    52	  const theme = typeof meta?.theme === 'string' ? meta.theme : undefined;
    53	  const common = { template, theme };
    54	
    55	  const hasRoot = hasInfographicRoot(message.a2ui_envelope);
    56	
    57	  // A widget-only a2ui turn (Chart/DataTable/KPICard/... root, no
    58	  // Infographic/Report) never opens the infographic canvas — out of scope
    59	  // regardless of the flag (spec §3 Module 3 "NOT in scope").
    60	  if (message.output_mode === 'a2ui' && !hasRoot) return null;
    61	
    62	  if (features.a2ui && message.a2ui_envelope && hasRoot) {
    63	    return {
    64	      mode: 'a2ui',
    65	      envelope: message.a2ui_envelope,
    66	      url,
    67	      html: inlineHtml || undefined,
    68	      ...common,
    69	    };
    70	  }

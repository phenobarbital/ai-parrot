   292	def setup_dataplane_guard(
   293	    app: web.Application,
   294	    *,
   295	    policy_dir: str = "policies",
   296	    cache_ttl: int = 30,
   297	) -> Optional[DataPlanePolicyGuard]:
   298	    """Build and register the default FEAT-598 data-plane authorization guard.
   299	
   300	    Runs :func:`setup_pbac` and, when it yields a working
   301	    ``PolicyEvaluator``, wraps it in a fresh :class:`DataPlanePolicyGuard`
   302	    (backed by a fresh :class:`~parrot.auth.rls_registry.RlsRegistry`),
   303	    registers it as ``app["dataplane_guard"]``, and returns it.
   304	
   305	    When PBAC cannot initialize (``setup_pbac`` returns ``(None, None,
   306	    None)`` — e.g. navigator-auth is not installed or no policy directory
   307	    exists), this function sets **nothing** on ``app`` and returns
   308	    ``None``. Linked A2UI surfaces (FEAT-598) must keep answering 403
   309	    (``LinkedGuardRequired``) in that state — wiring a guard that itself
   310	    fails open without navigator-auth would silently disable the owner
   311	    check, so absence of the key is the safe default on bare installs.
   312	
   313	    Idempotent: an existing ``app["dataplane_guard"]`` (set by a prior call,
   314	    a test, or an operator) is respected and returned unchanged.
   315	
   316	    Args:
   317	        app: The aiohttp ``web.Application`` to register the guard into.
   318	        policy_dir: Path to the PBAC policy directory. Defaults to
   319	            ``"policies"`` (see :data:`parrot.conf.PARROT_PBAC_POLICY_DIR`).
   320	        cache_ttl: Seconds before a cached policy decision expires. Passed
   321	            straight through to :func:`setup_pbac`.
   322	
   323	    Returns:
   324	        The registered :class:`DataPlanePolicyGuard`, or ``None`` when PBAC
   325	        is unavailable.
   326	
   327	    Raises:
   328	        RuntimeError: Propagated from :func:`setup_pbac` when
   329	            ``PARROT_SAAS_MODE=true`` and PBAC initialization fails
   330	            (fail-closed startup — never silently disables enforcement).
   331	    """
   332	    existing = app.get("dataplane_guard")
   333	    if existing is not None:
   334	        return existing
   335	
   336	    _pdp, evaluator, _guardian = setup_pbac(app, policy_dir=policy_dir, cache_ttl=cache_ttl)
   337	    if evaluator is None:
   338	        logger.info(
   339	            "PBAC unavailable — linked A2UI surfaces (FEAT-598) remain "
   340	            "disabled (fail-closed 403) until PBAC is configured via "
   341	            "PARROT_PBAC_POLICY_DIR (currently '%s').",
   342	            policy_dir,
   343	        )
   344	        return None
   345	
   346	    guard = DataPlanePolicyGuard(evaluator=evaluator, rls_registry=RlsRegistry())
   347	    app["dataplane_guard"] = guard
   348	    return guard


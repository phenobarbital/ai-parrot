   376	
   377	    def _error(self, message: str, *, status: int = 400) -> web.Response:
   378	        """Build a JSON error response directly via ``json_response``.
   379	
   380	        ``BaseView.error()`` only recognizes a fixed status whitelist
   381	        (400/401/403/404/406/412/428 — ``navigator/views/base.py``) and
   382	        silently falls back to ``HTTPBadRequest`` (400) for anything else
   383	        (the same landmine documented in ``handlers/comm_center.py``'s
   384	        ``_map_error``) — this handler needs 409/410/422/500/501/502/503 too,
   385	        so every error response is built directly instead, matching
   386	        ``RecipeHandler._error_response``'s approach in the sibling
   387	        ``infographic_recipes.py`` handler.
   388	        """
   389	        return self.json_response({"status": "error", "message": message}, status=status)

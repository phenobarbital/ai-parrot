   232	@_register("pivot")
   233	def _op_pivot(frame: "pd.DataFrame", op: Any, frames: Mapping[str, "pd.DataFrame"], index: int) -> "pd.DataFrame":
   234	    """Pivot one value column into first-appearance ordered aggregate columns."""
   235	    _require_columns(frame, list(op.index) + [op.columns, op.values], index, "pivot")
   236	    out = frame.pivot_table(
   237	        index=list(op.index),
   238	        columns=op.columns,
   239	        values=op.values,
   240	        aggfunc=_AGGS[op.aggregate],
   241	        sort=False,
   242	    ).reset_index()
   243	    return out.rename(columns={column: str(column) for column in out.columns})

   457	    async def _get_one(self, surface_id: str, user_id: str | None, scope: SurfaceScope) -> web.Response:
   458	        qs = self.query_parameters(self.request)
   459	        token = qs.get("share")
   460	        record, err = await self._resolve_surface_for_access(surface_id, user_id, token, scope)
   461	        if err is not None:
   462	            return err
   463	        accept = self.negotiation.negotiate(self.request)
   464	        return await self.negotiation.respond(record, accept)

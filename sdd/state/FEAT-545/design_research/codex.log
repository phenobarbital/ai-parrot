   536	    def _materialize_json_schema(self, output_model: Type[BaseModel]) -> str:
   537	        schema = output_model.model_json_schema()
   538	        fd, path = tempfile.mkstemp(prefix="dev_loop_codex_schema_", suffix=".json")
   539	        try:
   540	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
   541	                json.dump(schema, fh)
   542	        except Exception:
   543	            os.close(fd)
   544	            try:
   545	                os.unlink(path)
   546	            except OSError:
   547	                pass
   548	            raise
   549	        return path

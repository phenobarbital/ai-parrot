   526	    def _enforce_cwd_under_worktree_base(self, cwd: str) -> None:
   527	        base = os.path.abspath(conf.WORKTREE_BASE_PATH)
   528	        target = os.path.abspath(cwd)
   529	        try:
   530	            common = os.path.commonpath([base, target])
   531	        except ValueError:
   532	            common = ""
   533	        if common != base:
   534	            raise DispatchExecutionError(f"cwd {cwd!r} is not under WORKTREE_BASE_PATH={base!r}")
   535	
   536	    def _materialize_json_schema(self, output_model: Type[BaseModel]) -> str:
   537	        schema = output_model.model_json_schema()
   538	        fd, path = tempfile.mkstemp(prefix="dev_loop_codex_schema_", suffix=".json")
   539	        try:
   540	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
   541	                json.dump(schema, fh)
   542	        except Exception:
   543	            os.close(fd)

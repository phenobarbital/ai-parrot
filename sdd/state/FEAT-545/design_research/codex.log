   282	    def _build_review_scope_args(self, profile: CodexAdversarialReviewProfile) -> List[str]:
   283	        """Return the `codex exec review` scope-specific arguments (FEAT-375 G5).
   284	
   285	        Table-driven via ``_REVIEW_SCOPE_FLAGS`` so CLI-surface drift is
   286	        contained to this one mapping. Raises ``ValueError`` when a
   287	        non-``"uncommitted"`` scope is missing its required target.
   288	        """
   289	        if profile.review_scope == "uncommitted":
   290	            return []
   291	        flag = self._REVIEW_SCOPE_FLAGS[profile.review_scope]
   292	        value = profile.review_base if profile.review_scope == "base" else profile.review_commit
   293	        field_name = "review_base" if profile.review_scope == "base" else "review_commit"
   294	        if not value:
   295	            raise ValueError(
   296	                f"CodexAdversarialReviewProfile.review_scope={profile.review_scope!r} "
   297	                f"requires a non-empty {field_name}"
   298	            )
   299	        return [flag, value]

   272	# 1. Unstage everything first to ensure a clean staging area
   273	git reset HEAD
   274	
   275	# 2. Stage ONLY the per-spec index and new task files — NEVER use "git add ." or "git add -A"
   276	git add sdd/tasks/index/<feature-slug>.json
   277	git add sdd/tasks/active/TASK-*
   278	
   279	# 3. Verify ONLY task files are staged (nothing else)
   280	git diff --cached --name-only

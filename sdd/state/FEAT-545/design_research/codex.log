   588	    async def _ensure_redis(self) -> Any:
   589	        if self._redis is not None:
   590	            return self._redis
   591	        import redis.asyncio as aioredis
   592	
   593	        self._redis = aioredis.from_url(self._redis_url)
   594	        return self._redis

     1	"""Body parity between `.claude/commands/<name>.md` and its `.agent/workflows/<name>.md` twin (FEAT-545).
     2	
     3	The twin may differ ONLY by a leading YAML frontmatter block and by exactly
     4	ONE documented per-command substitution line (each references
     5	`AGENTS.md`/`sdd/WORKFLOW.md` where the `.claude/commands/` original
     6	references `CLAUDE.md`). Rather than dropping whatever is on the tolerated
     7	line (which would hide unrelated drift appended to it), this test applies
     8	the specific expected substitution to the original and asserts the result
     9	is byte-identical to the twin — any other difference, anywhere, still fails.
    10	Pattern: packages/ai-parrot/tests/flows/dev_loop/test_subagent_parity.py.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from pathlib import Path
    16	
    17	import pytest
    18	
    19	_REPO_ROOT = Path(__file__).resolve().parents[2]
    20	_TWINNED = ("sdd-spec", "sdd-task")
    21	
    22	# name -> (exact original substring, exact twin substring). Each pair must
    23	# appear exactly once in its respective file today; see TASK-3098's
    24	# Completion Note for how these were re-verified against a stale assumption.
    25	_SUBSTITUTIONS: dict[str, tuple[str, str]] = {
    26	    "sdd-spec": (
    27	        '- Worktree policy: `CLAUDE.md` (section "Worktree Policy")',
    28	        "- Worktree policy: `AGENTS.md` and `sdd/WORKFLOW.md`",
    29	    ),
    30	    "sdd-task": (
    31	        "(sub-features extend a parent feature branch — see `CLAUDE.md`).",
    32	        "(sub-features extend a parent feature branch — see `AGENTS.md`).",
    33	    ),
    34	}
    35	
    36	
    37	def _strip_frontmatter(text: str) -> str:
    38	    """Drop a leading ``---`` … ``---`` YAML block, if present."""
    39	    if not text.startswith("---\n"):
    40	        return text
    41	    end = text.find("\n---\n", 4)
    42	    return text if end == -1 else text[end + len("\n---\n") :].lstrip("\n")
    43	
    44	
    45	def _apply_expected_substitution(name: str, original_text: str) -> str:
    46	    """Apply the ONE documented twin-only substitution for `name`.
    47	
    48	    Asserts the substitution anchor is present exactly once, so a future
    49	    edit that changes or removes that line causes this test to fail loudly
    50	    (pointing at the stale anchor) rather than silently pass.
    51	    """
    52	    original_line, twin_line = _SUBSTITUTIONS[name]
    53	    count = original_text.count(original_line)
    54	    assert count == 1, (
    55	        f"{name}: expected exactly one occurrence of the tolerated-delta anchor "
    56	        f"{original_line!r} in .claude/commands/{name}.md, found {count}"
    57	    )
    58	    return original_text.replace(original_line, twin_line)
    59	
    60	
    61	@pytest.mark.parametrize("name", _TWINNED)
    62	def test_command_twin_parity(name: str) -> None:
    63	    """`.agent/workflows/<name>.md` body == `.claude/commands/<name>.md` body,
    64	    modulo frontmatter and the one documented substitution."""
    65	    original = _REPO_ROOT / ".claude" / "commands" / f"{name}.md"
    66	    twin = _REPO_ROOT / ".agent" / "workflows" / f"{name}.md"
    67	    if not original.is_file() or not twin.is_file():
    68	        pytest.skip(f"{name}: command or twin missing at this checkout")
    69	    got = _strip_frontmatter(twin.read_text(encoding="utf-8")).strip()
    70	    want = _apply_expected_substitution(name, original.read_text(encoding="utf-8")).strip()
    71	    assert got == want, f"{name}.md drifted between .claude/commands/ and .agent/workflows/"


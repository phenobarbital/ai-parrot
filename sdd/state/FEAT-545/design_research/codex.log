   557	    def _build_prompt(self, brief: BaseModel, output_model: Type[BaseModel]) -> str:
   558	        brief_json = brief.model_dump_json()
   559	        schema = output_model.model_json_schema()
   560	        properties = schema.get("properties", {}) or {}
   561	        required = schema.get("required", []) or []
   562	        field_lines: List[str] = []
   563	        for fname, fmeta in properties.items():
   564	            ftype = fmeta.get("type") or fmeta.get("$ref", "").rsplit("/", 1)[-1] or "any"
   565	            fdesc = (fmeta.get("description") or "").strip()
   566	            mandatory = " (required)" if fname in required else ""
   567	            line = f"  - {fname}: {ftype}{mandatory}"
   568	            if fdesc:
   569	                line += f" — {fdesc}"
   570	            field_lines.append(line)
   571	        fields_block = "\n".join(field_lines) or "  (no fields)"
   572	        required_block = ", ".join(required) if required else "(none)"
   573	        return (
   574	            f"Input brief:\n{brief_json}\n\n"
   575	            f"Respond with a single JSON object that matches the "
   576	            f"`{output_model.__name__}` schema. Use these EXACT field "
   577	            f"names — do not invent shorter aliases:\n"
   578	            f"{fields_block}\n\n"
   579	            f"Required fields (must be present and non-empty): "
   580	            f"{required_block}.\n\n"
   581	            f"Output rules:\n"
   582	            f"  1. Emit ONE JSON object — no surrounding prose.\n"
   583	            f"  2. No markdown fences around the JSON.\n"
   584	            f"  3. All required fields above must appear under their "
   585	            f"exact names."
   586	        )

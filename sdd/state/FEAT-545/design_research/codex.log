   376	        if stdout is None:
   377	            return
   378	        while True:
   379	            raw = await stdout.readline()
   380	            if not raw:
   381	                return
   382	            line = raw.decode("utf-8", errors="replace").strip()
   383	            if not line:
   384	                continue
   385	            try:
   386	                event = json.loads(line)

   388	                await self._publish_event(
   389	                    stream_key,
   390	                    kind="dispatch.message",
   391	                    run_id=run_id,
   392	                    node_id=node_id,
   393	                    payload={"raw_line": line},
   394	                )
   395	                continue
   396	            await self._publish_codex_event(stream_key, event, run_id, node_id)

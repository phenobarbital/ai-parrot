   526	    def _enforce_cwd_under_worktree_base(self, cwd: str) -> None:
   527	        base = os.path.abspath(conf.WORKTREE_BASE_PATH)
   528	        target = os.path.abspath(cwd)
   529	        try:
   530	            common = os.path.commonpath([base, target])
   531	        except ValueError:
   532	            common = ""
   533	        if common != base:
   534	            raise DispatchExecutionError(f"cwd {cwd!r} is not under WORKTREE_BASE_PATH={base!r}")

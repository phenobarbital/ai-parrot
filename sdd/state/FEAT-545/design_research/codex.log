   426	        Returns:
   427	            A dict of additive display keys (``tool_name``, ``tool_input``,
   428	            ``text``, and any status/exit detail the item carries). Empty
   429	            when nothing recognisable is present.
   430	        """
   431	        try:
   432	            out: Dict[str, Any] = {}
   433	            item = event.get("item") if isinstance(event, dict) else None
   434	            item_type = item.get("type") if isinstance(item, dict) else None
   435	
   436	            if item_type == "command_execution":
   437	                out["tool_name"] = "shell"
   438	                command = item.get("command")
   439	                if command:
   440	                    out["tool_input"] = summarize_tool_input("shell", {"command": command})
   441	                exit_code = item.get("exit_code")
   442	                if exit_code is not None:
   443	                    out["exit_code"] = exit_code
   444	                status = item.get("status")
   445	                if status:
   446	                    out["status"] = status
   447	            elif item_type == "file_change":
   448	                out["tool_name"] = "edit"
   449	                changes = item.get("changes")
   450	                path = item.get("path")
   451	                if changes:
   452	                    out["tool_input"] = summarize_tool_input("edit", {"path": str(changes)})
   453	                elif path:
   454	                    out["tool_input"] = summarize_tool_input("edit", {"path": path})
   455	            elif item_type == "mcp_tool_call":
   456	                server = item.get("server") or ""
   457	                tool = item.get("tool") or ""
   458	                name = " ".join(part for part in (server, tool) if part)
   459	                if name:
   460	                    out["tool_name"] = name
   461	                arguments = item.get("arguments")
   462	                if arguments is not None:
   463	                    out["tool_input"] = summarize_tool_input(name, arguments)
   464	            elif item_type == "web_search":
   465	                out["tool_name"] = "web_search"
   466	                query = item.get("query")
   467	                if query:
   468	                    out["tool_input"] = summarize_tool_input("web_search", {"prompt": query})
   469	            else:
   470	                text = None
   471	                if isinstance(item, dict):
   472	                    text = item.get("text")
   473	                if not text and isinstance(event, dict):
   474	                    text = event.get("message")
   475	                if text:
   476	                    out["text"] = str(text)[:400]
   477	
   478	            return out
   479	        except Exception:  # noqa: BLE001 - telemetry must never break a dispatch
   480	            return {}
   481	
   482	    def _codex_event_kind(self, event: Dict[str, Any]) -> str:
   483	        event_type = event.get("type")
   484	        item = event.get("item")
   485	        item_type = item.get("type") if isinstance(item, dict) else None
   486	        if event_type == "item.started" and item_type in self._TOOL_ITEM_TYPES:
   487	            return "dispatch.tool_use"
   488	        if event_type == "item.completed" and item_type in self._TOOL_ITEM_TYPES:
   489	            return "dispatch.tool_result"
   490	        return "dispatch.message"

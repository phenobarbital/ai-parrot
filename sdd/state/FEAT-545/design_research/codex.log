     1	"""Body parity between `.claude/commands/<name>.md` and its `.agent/workflows/<name>.md` twin (FEAT-545).
     2	
     3	The twin may differ ONLY by a leading YAML frontmatter block and by the
     4	`- Worktree policy:` reference line; every other line must be identical.
     5	Pattern: packages/ai-parrot/tests/flows/dev_loop/test_subagent_parity.py.
     6	"""
     7	from __future__ import annotations
     8	
     9	from pathlib import Path
    10	
    11	import pytest
    12	
    13	_REPO_ROOT = Path(__file__).resolve().parents[2]
    14	_TWINNED = ("sdd-spec", "sdd-task")
    15	
    16	
    17	def _strip_frontmatter(text: str) -> str:
    18	    """Drop a leading ``---`` … ``---`` YAML block, if present."""
    19	    if not text.startswith("---\n"):
    20	        return text
    21	    end = text.find("\n---\n", 4)
    22	    return text if end == -1 else text[end + len("\n---\n"):].lstrip("\n")
    23	
    24	
    25	def _normalize(text: str) -> str:
    26	    """Remove the tolerated delta lines and trailing whitespace noise.
    27	
    28	    Two twin-only substitutions exist today, one per command (each references
    29	    `AGENTS.md`/`sdd/WORKFLOW.md` where the `.claude/commands/` original
    30	    references `CLAUDE.md`): `sdd-spec.md`'s "- Worktree policy:" line, and
    31	    `sdd-task.md`'s "sub-features extend a parent feature branch" line. Both
    32	    are stripped so the remaining body must match exactly.
    33	    """
    34	    lines = [
    35	        ln
    36	        for ln in text.splitlines()
    37	        if not ln.startswith("- Worktree policy:")
    38	        and "sub-features extend a parent feature branch — see `" not in ln
    39	    ]
    40	    return "\n".join(lines).strip()
    41	
    42	
    43	@pytest.mark.parametrize("name", _TWINNED)
    44	def test_command_twin_parity(name: str) -> None:
    45	    """`.agent/workflows/<name>.md` body == `.claude/commands/<name>.md` body."""
    46	    original = _REPO_ROOT / ".claude" / "commands" / f"{name}.md"
    47	    twin = _REPO_ROOT / ".agent" / "workflows" / f"{name}.md"
    48	    if not original.is_file() or not twin.is_file():
    49	        pytest.skip(f"{name}: command or twin missing at this checkout")
    50	    got = _normalize(_strip_frontmatter(twin.read_text(encoding="utf-8")))
    51	    want = _normalize(original.read_text(encoding="utf-8"))
    52	    assert got == want, f"{name}.md drifted between .claude/commands/ and .agent/workflows/"


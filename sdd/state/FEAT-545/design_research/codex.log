   301	    def _build_adversarial_review_command(
   302	        self,
   303	        *,
   304	        profile: CodexAdversarialReviewProfile,
   305	        cwd: str,
   306	        schema_path: str,
   307	        output_path: str,
   308	        prompt: str,
   309	    ) -> List[str]:
   310	        """Build `codex exec review` / `codex exec resume --last` shapes (FEAT-375 G5/G6).
   311	
   312	        The installed CLI treats ``--cd``, ``--sandbox``, and ``--model`` as
   313	        options of the top-level ``exec`` command that MUST precede the
   314	        ``review``/``resume`` subcommand name (verified via ``codex exec
   315	        review --help`` / ``codex exec resume --help`` — neither subcommand
   316	        lists them as its own options). ``--json``, ``--output-schema``,
   317	        ``-o``, ``--ignore-user-config``, and ``--ignore-rules`` are
   318	        subcommand-level options and follow the subcommand name.
   319	
   320	        ``codex exec resume`` does not honor ``--sandbox`` (the gotcha
   321	        documented in the repo's ``CLAUDE.md``): omit it and pass
   322	        ``-c sandbox_mode="<mode>"`` instead so the read-only restriction
   323	        still applies to the resumed turn.
   324	        """
   325	        cmd = [self.codex_bin, "exec", "--cd", cwd]
   326	        if not profile.resume_last:
   327	            cmd += ["--sandbox", profile.sandbox]
   328	        cmd += ["--model", profile.model]
   329	
   330	        if profile.resume_last:
   331	            cmd += ["-c", f'sandbox_mode="{profile.sandbox}"']
   332	            cmd += ["resume", "--last"]
   333	        else:
   334	            cmd.append("review")
   335	            cmd += self._build_review_scope_args(profile)
   336	
   337	        cmd += ["--json", "--output-schema", schema_path, "-o", output_path]
   338	        if profile.ignore_user_config:
   339	            cmd.append("--ignore-user-config")
   340	        if profile.ignore_rules:
   341	            cmd.append("--ignore-rules")
   342	        cmd.append(prompt)
   343	        return cmd

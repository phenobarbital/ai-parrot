    55	class CodexAdversarialReviewProfile(CodexCodeDispatchProfile):
    56	    """Advisory review profile for the Codex adversarial second-opinion (FEAT-375).
    57	
    58	    Read-only, neutral-brief, no-writes profile: the dispatcher runs
    59	    ``codex exec review`` (or ``codex exec resume --last``) in a read-only
    60	    sandbox with the ``sdd-secondopinion`` subagent brief, which by
    61	    construction never receives the primary agent's reasoning.
    62	    """
    63	
    64	    subagent: Literal["sdd-secondopinion"] = "sdd-secondopinion"
    65	    sandbox: Literal["read-only"] = "read-only"
    66	    approval_policy: Literal["never"] = "never"
    67	    review_scope: Literal["uncommitted", "base", "commit"] = "uncommitted"
    68	    review_base: str = ""
    69	    review_commit: str = ""
    70	    resume_last: bool = Field(
    71	        default=False,
    72	        description="G6: use `codex exec resume --last` to continue the existing review session.",
    73	    )
    74	    # A read-only diff review needs minutes, not half an hour: the reviewer
    75	    # cannot run tests (nothing is writable in the read-only sandbox, not
    76	    # even /tmp), so a long timeout only pays for retry spirals when the
    77	    # model attempts a command anyway.
    78	    timeout_seconds: int = Field(default=600, ge=60, le=7200)


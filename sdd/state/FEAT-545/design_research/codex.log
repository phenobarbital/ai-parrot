   492	    async def _read_stream(self, stream: Any) -> str:
   493	        if stream is None:
   494	            return ""
   495	        data = await stream.read()
   496	        if isinstance(data, bytes):
   497	            return data.decode("utf-8", errors="replace")
   498	        return str(data or "")

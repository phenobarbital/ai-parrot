    def _split_payload(
        self, data: Dict[str, Any]
    ) -> Tuple[Dict[str, Any], Optional[List[dict]], Optional[List[dict]]]:
        """Separate plain columns from encrypted blobs."""
        plain: Dict[str, Any] = {}
        for key, value in data.items():

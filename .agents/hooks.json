{
  "parrot-sdd-permissions": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh ../scripts/sdd/agy_hook.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "parrot-sdd-experience": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "parrot sdd experience hook --host agy --event post",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "parrot sdd experience hook --host agy --event post-invocation",
        "timeout": 5
      }
    ]
  }
}

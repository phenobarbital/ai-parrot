{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormControlsResponse",
  "description": "Response payload for `GET /api/v1/form-controls`. Returned by parrot-formdesigner's API for the toolbar palette.",
  "type": "object",
  "required": ["controls"],
  "additionalProperties": false,
  "properties": {
    "controls": {
      "type": "array",
      "description": "Registered form-control entries, in registration order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label",
          "description",
          "category",
          "icon",
          "snippet",
          "render_hint",
          "supports_constraints",
          "is_container",
          "supported_operators",
          "supported_effects",
          "supported_operations",
          "value_shape"
        ],
        "properties": {
          "type": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "category": {
            "type": "string",
            "enum": ["basic", "selection", "media", "layout", "advanced"]
          },
          "icon": {"type": "string"},
          "snippet": {"type": "object"},
          "render_hint": {"type": "string"},
          "supports_constraints": {"type": "boolean"},
          "is_container": {"type": "boolean"},
          "supported_operators": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supported_effects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supported_operations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "value_shape": {"type": "object"}
        }
      }
    }
  }
}

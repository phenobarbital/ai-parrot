{
  "version": "0.1.1",
  "dialects": ["ANSI_SQL"],
  "semantic_model": [
    {
      "name": "orders",
      "description": "Orders semantic model backed by physical warehouse columns",
      "datasets": [
        {
          "name": "orders",
          "source": "sales.orders",
          "primary_key": ["id"],
          "fields": [
            {
              "name": "id",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "id"}]
              }
            },
            {
              "name": "customer_id",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "customer_id"}]
              }
            },
            {
              "name": "region",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "region"}]
              },
              "dimension": {"is_time": false}
            },
            {
              "name": "tenant_id",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "tenant_id"}]
              }
            },
            {
              "name": "order_date",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "order_date"}]
              },
              "dimension": {"is_time": true}
            },
            {
              "name": "amount",
              "expression": {
                "dialects": [{"dialect": "ANSI_SQL", "expression": "amount"}]
              }
            }
          ]
        }
      ],
      "metrics": [
        {
          "name": "revenue",
          "description": "Total order revenue using the physical amount input",
          "expression": {
            "dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(orders.amount)"}]
          }
        }
      ]
    }
  ]
}

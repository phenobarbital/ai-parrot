{
  "description": "Unified needs-auth payload serialized by ToolManager and AgentTalk.",
  "properties": {
    "auth_kind": {
      "anyOf": [
        {
          "enum": [
            "obo",
            "oauth2",
            "static_key",
            "mcp",
            "device_code"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth Kind"
    },
    "auth_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth Url"
    },
    "expires_in": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires In"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "title": "Scopes",
      "type": "array"
    },
    "tool_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Name"
    },
    "user_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Code"
    },
    "verification_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Uri"
    }
  },
  "required": [
    "provider"
  ],
  "title": "AuthRequiredPayload",
  "type": "object"
}

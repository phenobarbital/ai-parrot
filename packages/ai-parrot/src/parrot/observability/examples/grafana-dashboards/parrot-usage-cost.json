    {
      "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": false } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 16,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{parrot_agent_name=~\"${agent:regex}\", gen_ai_response_model=~\"${model:regex}\", gen_ai_provider_name=~\"${provider:regex}\"}[5m])))",
          "legendFormat": "p50", "range": true, "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{parrot_agent_name=~\"${agent:regex}\", gen_ai_response_model=~\"${model:regex}\", gen_ai_provider_name=~\"${provider:regex}\"}[5m])))",
          "legendFormat": "p95", "range": true, "refId": "B"
        }
      ],
      "title": "p50 / p95 latency",
      "type": "timeseries"
    }
  ]

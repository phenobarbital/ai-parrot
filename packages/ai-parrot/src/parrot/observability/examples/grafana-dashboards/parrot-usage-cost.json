    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "id": 14, "title": "Health", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
      "description": "gen_ai.client.error.count exists in the instrument catalog but was not observed to emit in TASK-3108's live verification (see series-names.md Findings #1) — an error-rate-by-agent panel is deliberately omitted here rather than authored against an unconfirmed series name. Add it once that finding is resolved.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": false } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 15,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
          "editorMode": "code",
          "expr": "sum by (parrot_agent_name) (rate(gen_ai_client_request_count_total{parrot_agent_name=~\"${agent:regex}\", gen_ai_request_model=~\"${model:regex}\", gen_ai_provider_name=~\"${provider:regex}\"}[5m]))",

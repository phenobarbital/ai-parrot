    },
    {
      "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "id": 13,
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "claudestats-prometheus" },
          "editorMode": "code",
          "expr": "sum by (gen_ai_response_model, gen_ai_provider_name) (gen_ai_client_cost_USD_total{parrot_agent_name=~\"${agent:regex}\", gen_ai_response_model=~\"${model:regex}\", gen_ai_provider_name=~\"${provider:regex}\"})",
          "format": "table", "instant": true, "range": false, "refId": "A"
        }
      ],
      "title": "Cumulative cost by model + provider",

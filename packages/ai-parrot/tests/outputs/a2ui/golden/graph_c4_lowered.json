        "text": "C4Container\ntitle Order platform \u2014 containers\nPerson(customer, \"Customer\", \"Places orders\")\nSystem_Ext(payments, \"Payment Provider\", \"Card processing\")\nSystem_Boundary(platform, \"Order Platform\") {\n    Container(web, \"Web App\", \"SvelteKit\", \"Storefront UI\")\n    Container(api, \"Order API\", \"aiohttp\", \"Order lifecycle\")\n    ContainerDb(db, \"Orders DB\", \"PostgreSQL\")\n}\nRel(customer, web, \"Uses\", \"HTTPS\")\nRel(web, api, \"Calls\", \"JSON/HTTPS\")\nBiRel(api, db, \"Reads/writes\", \"asyncpg\")\nRel(api, payments, \"Charges\", \"REST\")\nRel_Back(payments, api, \"Webhook\", \"HTTPS\")\n"

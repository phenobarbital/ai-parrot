  {
    "description": "Show one SDD ledger issue in full: state, body and event history.",
    "mount": "ledger",
    "name": "ledger_show",
    "schema": {"description": "Schema mirrors `wikitoolkit ledger show` one for one.", "properties": {"include_history": {"default": true, "description": "Include the issue's event history", "title": "Include History", "type": "boolean"}, "issue_id": {"description": "Issue id, with or without the issue: prefix", "title": "Issue Id", "type": "string"}}, "required": ["issue_id"], "title": "LedgerShowInput", "type": "object"}
  },
  {
    "description": "Find every symbol that transitively depends on (calls/extends/implements) a given symbol \u2014 the 'blast radius' of changing it. Use before editing a widely-used function or class.",
    "mount": "structural",
    "name": "wiki_blast_radius",
    "schema": {
      "description": "Arguments for ``wiki_blast_radius`` / ``code_blast_radius``.",
      "properties": {
        "depth": {
          "default": 2,
          "description": "Maximum BFS depth",
          "maximum": 5,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "include_inferred": {
          "default": true,
          "description": "Follow provenance='inferred' edges (globally-unique-name resolutions)",
          "title": "Include Inferred",
          "type": "boolean"
        },
        "include_tests": {
          "default": true,
          "description": "Include symbols under a tests/ path",
          "title": "Include Tests",
          "type": "boolean"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Federated namespace to read: a namespace name, 'all' to broadcast, 'local' for this repo's own wiki. Omit for the default routing (broadcast when namespaces are configured).",
          "title": "Namespace"
        },
        "relations": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "calls",
                  "extends",
                  "implements",
                  "uses",
                  "references",
                  "contains"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Edge relations to follow (default: calls, extends, implements, uses)",
          "title": "Relations"
        },
        "symbol": {
          "description": "A sym: id or an exact qualname",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "BlastRadiusInput",
      "type": "object"
    }
  },
  {
    "description": "Get the symbol outline of a file \u2014 every top-level (and nested, depth-bounded) class/function/method, with line ranges. Use before reading a whole file to see its shape first.",
    "mount": "structural",
    "name": "wiki_code_outline",
    "schema": {
      "description": "Arguments for ``wiki_code_outline`` / ``code_outline``.",
      "properties": {
        "depth": {
          "default": 2,
          "description": "Maximum symbol nesting depth",
          "maximum": 4,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "include_source": {
          "default": false,
          "description": "Include a capped source excerpt (sym: targets only)",
          "title": "Include Source",
          "type": "boolean"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Federated namespace to read: a namespace name, 'all' to broadcast, 'local' for this repo's own wiki. Omit for the default routing (broadcast when namespaces are configured).",
          "title": "Namespace"
        },
        "target": {
          "description": "A file:<rel>, sym:<rel>#<qualname>, or bare relative path",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "CodeOutlineInput",
      "type": "object"
    }
  },
  {
    "description": "Answer a 'why' question about the codebase with cited decision excerpts and supporting code. Documented decisions rank above inferred candidates, which are returned in their own labeled group.",
    "mount": "decisions",
    "name": "wiki_decision_why",
    "schema": {
      "description": "Arguments for ``wiki_decision_why`` / ``decision_why``.",
      "properties": {
        "budget_tokens": {
          "default": 3000,
          "description": "Estimated output budget",
          "minimum": 256,
          "title": "Budget Tokens",
          "type": "integer"
        },
        "include_history": {
          "default": false,
          "description": "Include rejected/deprecated/superseded records",
          "title": "Include History",
          "type": "boolean"
        },
        "limit": {
          "default": 10,
          "description": "Maximum hits across both groups",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Federated namespace to read: a namespace name, or 'local' for this repo's own wiki. 'all' is not supported for decisions.",
          "title": "Namespace"
        },
        "question": {
          "description": "Natural-language question, optionally naming a symbol",
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "DecisionWhyInput",
      "type": "object"
    }
  },
  {
    "description": "Find architectural decisions (ADRs) that apply to a function, class or method, with source citations. Documented decisions and inferred candidates are returned as separate, explicitly labeled groups \u2014 a candidate is a hypothesis, not accepted history.",
    "mount": "decisions",
    "name": "wiki_decisions_for_symbol",
    "schema": {
      "description": "Arguments for ``wiki_decisions_for_symbol`` / ``decision_for_symbol``.",
      "properties": {
        "budget_tokens": {
          "default": 3000,
          "description": "Estimated output budget",
          "minimum": 256,
          "title": "Budget Tokens",
          "type": "integer"
        },
        "include_history": {
          "default": false,
          "description": "Include rejected/deprecated/superseded records",
          "title": "Include History",
          "type": "boolean"
        },
        "limit": {
          "default": 10,
          "description": "Maximum hits across both groups",
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Federated namespace to read: a namespace name, or 'local' for this repo's own wiki. 'all' is not supported for decisions.",
          "title": "Namespace"
        },
        "symbol": {
          "description": "A sym:<rel>#<qualname> id, or an exact symbol name",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "DecisionsForSymbolInput",
      "type": "object"
    }
  },
  {
    "description": "Lint the wiki knowledge graph: broken links, duplicate slugs, stale memories, ADR conflicts; fix=true applies safe fixes.",
    "mount": "core",

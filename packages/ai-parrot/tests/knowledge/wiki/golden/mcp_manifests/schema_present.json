            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule ids or packs to run (default: all deterministic).",
          "title": "Rules"
        },
        "skip": {
          "description": "Rule ids to skip.",
          "items": {
            "type": "string"
          },
          "title": "Skip",
          "type": "array"
        }
      },
      "title": "WikiLintInput",
      "type": "object"
    }
  },
  {

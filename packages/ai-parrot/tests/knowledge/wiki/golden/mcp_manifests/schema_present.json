  {
    "description": "List SDD ledger issues by status (or all), kind, severity or about prefix.",
    "mount": "ledger",
    "name": "ledger_list",
    "schema": {"description": "Schema mirrors `wikitoolkit ledger list` options one for one.", "properties": {"about_prefix": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Keep issues with an about entry starting with this prefix", "title": "About Prefix"}, "all_statuses": {"default": false, "description": "Include every status; overrides statuses", "title": "All Statuses", "type": "boolean"}, "kind": {"anyOf": [{"enum": ["bug", "tech_debt", "feature_gap", "vulnerability"], "type": "string"}, {"type": "null"}], "default": null, "description": "Filter by issue kind", "title": "Kind"}, "severity": {"anyOf": [{"enum": ["critical", "major", "minor", "low"], "type": "string"}, {"type": "null"}], "default": null, "description": "Filter by severity", "title": "Severity"}, "statuses": {"anyOf": [{"items": {"enum": ["open", "claimed", "closed", "superseded"], "type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "Statuses to include (default open+claimed)", "title": "Statuses"}}, "title": "LedgerListInput", "type": "object"}
  },
  {
    "description": "Open a new issue in the SDD work ledger.",
    "mount": "ledger",
    "name": "ledger_open",
    "schema": {
      "properties": {
        "about": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Affected symbols/files, repo-relative, e.g. sym:pkg/mod.py#Func",
          "title": "About"
        },
        "body": {
          "description": "What is wrong, where (file + symbol), why it matters, suggested fix",
          "title": "Body",
          "type": "string"
        },
        "discovered_from": {
          "description": "Source: spec:<FEAT-ID>, task:<TASK-ID> or review:<TASK-ID>",
          "minLength": 1,
          "title": "Discovered From",
          "type": "string"
        },
        "kind": {
          "default": "bug",
          "description": "Issue kind: bug|tech_debt|feature_gap|vulnerability",
          "enum": [
            "bug",
            "tech_debt",
            "feature_gap",
            "vulnerability"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "default": "minor",
          "description": "Issue severity: critical|major|minor|low",
          "enum": [
            "critical",
            "major",
            "minor",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "description": "One-line issue title",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "body",
        "discovered_from"
      ],
      "title": "LedgerOpenInput",
      "type": "object"
    }
  },
  {

  {
    "description": "Search the codebase knowledge graph for files, modules, symbols, or concepts. Returns ranked page stubs with IDs for drill-down. Use BEFORE grep/find/Read on large repos. When federated namespaces are configured this searches all of them and foreign page IDs come back prefixed (ns::file:a.py); pass `namespace` to search just one.",
    "mount": "core",
    "name": "wiki_query",
    "schema": {
      "properties": {
        "budget_tokens": {
          "default": 1200,
          "description": "Token budget for results",
          "title": "Budget Tokens",
          "type": "integer"
        },
        "include_symbols": {
          "default": false,
          "description": "Include sym: (function/class/method) stubs in results (FEAT-498). Off by default \u2014 use wiki_symbol_lookup for symbol-specific search; set True to see symbols mixed in with files/concepts here.",
          "title": "Include Symbols",
          "type": "boolean"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Federated namespace to read: a namespace name, 'all' to broadcast, 'local' for this repo's own wiki. Omit for the default routing (broadcast when namespaces are configured).",
          "title": "Namespace"
        },
        "question": {
          "description": "Search question for the knowledge graph",
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "WikiQueryInput",
      "type": "object"
    }
  },

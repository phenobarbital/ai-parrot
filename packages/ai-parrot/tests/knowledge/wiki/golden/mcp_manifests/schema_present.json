  {
    "description": "Render a daily, weekly or monthly wiki brief. Read-only unless writes are explicitly enabled.",
    "mount": "core",
    "name": "wiki_standup",
    "schema": {
      "description": "Explicit brief options; persistence and model calls are opt-in over MCP.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor date (YYYY-MM-DD); default today.",
          "title": "Date"
        },
        "horizon_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Meeting horizon in days (1-90).",
          "title": "Horizon Days"
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "en",
                "es"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brief language.",
          "title": "Language"
        },
        "period": {
          "default": "day",
          "description": "Brief period.",
          "enum": [
            "day",
            "week",

            "type",
            "package",
            "role",
            "field",
            "attribute",
            "mod",
            "component"
          ],
          "title": "SymbolKind",
          "type": "string"
        }
      },
      "description": "Arguments for ``wiki_symbol_lookup`` / ``code_symbol_lookup``.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
